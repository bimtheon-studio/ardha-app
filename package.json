{
  "name": "ardha",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=26.10.0 <27",
    "pnpm": ">=12.8.1 <13"
  },
  "scripts": {
    "start": "node tools/stack/cli.ts start",
    "stop": "node tools/stack/cli.ts stop",
    "destroy": "node tools/stack/cli.ts destroy",
    "status": "node tools/stack/cli.ts status",
    "build": "swc src -d dist --strip-leading-paths --ignore '**/*.test.ts' && pnpm --filter ./frontend run build",
    "build:back": "swc src -d dist --strip-leading-paths --ignore '**/*.test.ts'",
    "dev:compiler": "swc src -d dist --strip-leading-paths --ignore '**/*.test.ts' --watch",
    "dev:api": "node --watch-path=dist --enable-source-maps dist/routes/main.js",
    "dev:worker": "node --watch-path=dist --enable-source-maps dist/worker/main.js",
    "cli": "node --enable-source-maps dist/cli/main.js",
    "migrate": "node --enable-source-maps dist/cli/main.js migrate",
    "seed": "node --enable-source-maps dist/cli/main.js seed",
    "migration:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tools && tsc --noEmit -p e2e && pnpm --filter ./frontend run typecheck",
    "lint": "eslint .",
    "test": "vitest run --coverage && pnpm --filter ./frontend run test",
    "doctrine": "node tools/doctrine/cli.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.1.1",
    "@nestjs/core": "12.1.1",
    "@nestjs/platform-express": "12.1.1",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.1",
    "bullmq": "6.3.10",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.3",
    "ioredis": "6.0.0",
    "nest-commander": "3.21.0",
    "nestjs-pino": "5.2.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.1.1",
    "@playwright/test": "1.63.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.12",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.2",
    "chokidar": "5.0.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "nest-commander-testing": "3.6.0",
    "pg": "8.23.0",
    "pino-pretty": "13.1.3",
    "supertest": "7.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.2"
  }
}
