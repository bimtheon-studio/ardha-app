#!/usr/bin/env bash
# Environnements d'Ardha sur le serveur once (lot LD, D-13) : la production et un environnement par PR.
# Chaque environnement = une application once (`ardha…`), une base `ardha_<nom>` et son rôle, un
# préfixe Redis `ardha-<nom>`. Copié sur le serveur par la commande de déploiement du dépôt ; ne
# touche qu'à ce qui porte le nom d'Ardha (le serveur est partagé).
#
#   ardha-env setup                                  services partagés (Postgres, Redis), secrets
#   ardha-env create <nom> --image <image> [--empty-db]   crée l'environnement et le déploie ; une PR part d'une copie de la production
#   ardha-env update <nom> --image <image> [--reset-db [--empty-db]]
#   ardha-env remove <nom> [--confirm production]    supprime tout : application, base, clés Redis
#   ardha-env list                                   environnements, hôte, image, état
#   ardha-env logs <nom> [--tail <n>] [--follow]     journaux du conteneur
#   ardha-env exec <nom> <commande…>                 commande dans le conteneur (once exec)
#   ardha-env psql <nom> [arguments de psql…]        psql sur la base de l'environnement
#   ardha-env registry --username <u>                identifiants de ghcr.io (jeton lu sur l'entrée standard)
#   ardha-env app-secret <NOM>                       secret de l'application pour tous les environnements (valeur lue sur l'entrée standard)
#   ardha-env sweep --keep <pr-1,pr-7,…>             supprime les PR absentes de la liste (fermées)
#   ardha-env ci                                     commande forcée de la clé SSH de la CI
#
# <nom> : `production` ou `pr-<numéro>`.
set -euo pipefail

ARDHA_HOME=${ARDHA_HOME:-$HOME/ardha}
ARDHA_DOMAIN=${ARDHA_DOMAIN:-once.florent.cc}
ARDHA_SERVICES=${ARDHA_SERVICES:-ardha}
ARDHA_COMPOSE_PROJECT=${ARDHA_COMPOSE_PROJECT:-ardha-services}
ARDHA_NETWORK=${ARDHA_NETWORK:-once}
ARDHA_MAX_PR=${ARDHA_MAX_PR:-4}
ARDHA_MEMORY_PRODUCTION=${ARDHA_MEMORY_PRODUCTION:-1024}
ARDHA_MEMORY_PR=${ARDHA_MEMORY_PR:-512}
ONCE=${ONCE:-once}

POSTGRES="$ARDHA_SERVICES-postgres"
REDIS="$ARDHA_SERVICES-redis"
SECRETS="$ARDHA_HOME/secrets.env"
ENVS="$ARDHA_HOME/envs"

die() {
  echo "ardha-env : $*" >&2
  exit 1
}

usage() {
  sed -n '/^#   ardha-env/s/^#   //p' "$0" >&2
  exit 2
}

random_secret() {
  head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' | head -c 48
}

# Noms dérivés d'un environnement.
check_name() {
  [[ ${1:-} =~ ^(production|pr-[0-9]{1,6})$ ]] || die "nom invalide « ${1:-} » : production ou pr-<numéro>"
}
host_of() { if [[ $1 == production ]]; then echo "ardha.$ARDHA_DOMAIN"; else echo "ardha-$1.$ARDHA_DOMAIN"; fi; }
database_of() { echo "ardha_${1//-/_}"; }
prefix_of() { echo "ardha-$1"; }
env_file() { echo "$ENVS/$1.env"; }
meta_file() { echo "$ENVS/$1.meta"; }

meta() { # meta <nom> <clé>
  sed -n "s/^$2=//p" "$(meta_file "$1")" 2>/dev/null || true
}

sql() { # sql <base> : exécute l'entrée standard en superutilisateur
  docker exec -i "$POSTGRES" psql -v ON_ERROR_STOP=1 -qAt -U postgres -d "$1"
}

services_ready() {
  [[ $(docker inspect -f '{{.State.Health.Status}}' "$POSTGRES" 2>/dev/null) == healthy ]] \
    || die "$POSTGRES n'est pas prêt : lancer « ardha-env setup »"
  [[ $(docker inspect -f '{{.State.Health.Status}}' "$REDIS" 2>/dev/null) == healthy ]] \
    || die "$REDIS n'est pas prêt : lancer « ardha-env setup »"
}

once_hosts() {
  # `once list` colore et lie les hôtes (OSC 8, terminées par BEL chez once v0.3.3, ou par ESC \) :
  # on n'en garde que le texte.
  "$ONCE" list | sed -E 's/\x1b\]8;;[^\x07\x1b]*(\x07|\x1b\\)//g; s/\x1b\[[0-9;]*m//g'
}

app_exists() { once_hosts | grep -q "^$1 "; }

# Conteneur once d'un hôte : once range ses réglages (hôte compris) dans l'étiquette `once`.
container_of() {
  local host=$1 name label
  while IFS=$'\t' read -r name label; do
    if [[ $label == *"\"host\":\"$host\""* ]]; then
      echo "$name"
      return
    fi
  done < <(docker ps --filter "name=^once-app-ardha" --format '{{.Names}}	{{.Label "once"}}')
  die "aucun conteneur en service pour $host"
}

# Arguments `--env` de once : le fichier de l'environnement, puis les secrets de l'application
# (`APP_<NOM>` de secrets.env, `ardha-env app-secret`), communs à tous (update les remplace tous).
env_args() {
  local line
  while IFS= read -r line; do
    [[ -n $line && $line != \#* ]] && printf '%s\0' --env "$line"
  done < "$(env_file "$1")"
  if [[ -f $SECRETS ]]; then
    while IFS= read -r line; do
      printf '%s\0' --env "${line#APP_}"
    done < <(grep '^APP_' "$SECRETS" || true)
  fi
}

# Identifiants de ghcr.io (paquet privé), s'il y en a dans secrets.env (`ardha-env registry`) : once
# reçoit le nom en argument, le jeton par l'entrée standard.
registry_args() {
  if [[ -f $SECRETS ]] && grep -q '^REGISTRY_USERNAME=' "$SECRETS"; then
    printf '%s\n' --registry-username "$(sed -n 's/^REGISTRY_USERNAME=//p' "$SECRETS")" --registry-password-stdin
  fi
}
registry_password() { sed -n 's/^REGISTRY_PASSWORD=//p' "$SECRETS" 2>/dev/null || true; }

create_database() {
  local db=$1 password=$2
  sql postgres <<SQL
CREATE ROLE $db LOGIN PASSWORD '$password';
CREATE DATABASE $db OWNER $db;
SQL
  # Les extensions appartiennent au serveur (superutilisateur) ; les migrations les trouvent déjà là.
  sql "$db" <<SQL
CREATE EXTENSION IF NOT EXISTS postgis;
CREATE EXTENSION IF NOT EXISTS vector;
GRANT ALL ON SCHEMA public TO $db;
SQL
}

drop_database() {
  local db=$1
  sql postgres <<SQL
DROP DATABASE IF EXISTS $db WITH (FORCE);
DROP ROLE IF EXISTS $db;
SQL
}

drop_redis_keys() {
  docker exec "$REDIS" redis-cli --scan --pattern "$1:*" \
    | xargs -r -n 500 docker exec -i "$REDIS" redis-cli del >/dev/null
}

# Copie de la production (porteur du produit, 13/10/2026 : « copier la bdd de prod par défaut lors
# d'un nouvel env, comme ça on peut reprendre les dossiers ») : une base de PR neuve part d'une copie
# de la base de la production, puis de ses fichiers une fois le conteneur démarré. Les comptes
# suivent (mêmes e-mails, mots de passe et rôles) ; ni les sessions ni les liens de réinitialisation.
# Sans production, ou si la copie échoue, la base reste vide et le seed au démarrage la remplit.
# Les objets copiés appartiennent au rôle de la PR ; les extensions, déjà là, ne sont pas copiées.
# Les messages de pg_dump et pg_restore peuvent citer des lignes de la base (e-mails, empreintes) :
# ils vont dans `envs/<nom>.copy.log` (600), jamais sur la sortie, que la CI publie.
copy_production_database() { # copy_production_database <nom> <base> : rend 0 si la base est copiée
  local name=$1 db=$2 log
  log="$ENVS/$name.copy.log"
  [[ -f $(env_file production) ]] || { echo "Pas de production à copier." >&2; return 1; }
  (umask 077 && : > "$log")
  if docker exec "$POSTGRES" pg_dump -U postgres -Fc --no-owner --no-acl --exclude-extension='*' -d "$(database_of production)" 2>> "$log" \
    | docker exec -i "$POSTGRES" pg_restore -U postgres --no-owner --no-acl --role="$db" --exit-on-error --single-transaction -d "$db" 2>> "$log" \
    && sql "$db" <<< 'DELETE FROM sessions; DELETE FROM password_resets;' 2>> "$log"; then
    return 0
  fi
  echo "ardha-env : détail sur le serveur, $log" >&2
  return 1
}

# Base neuve d'un environnement ; copiée de la production pour une PR, sauf `--empty-db`. Laisse
# `copied` à true quand la copie a réussi (les fichiers suivront).
copied=false
prepare_database() { # prepare_database <nom> <base> <mot de passe> <copier : true|false>
  local name=$1 db=$2 password=$3 copy=$4
  create_database "$db" "$password"
  [[ $name == pr-* && $copy == true ]] || { echo "Base $db vide."; return; }
  if copy_production_database "$name" "$db"; then
    copied=true
    echo "Base $db copiée de la production."
  else
    drop_database "$db"
    create_database "$db" "$password"
    echo "ardha-env : copie de la production impossible ; base $db vide (le seed la remplira)." >&2
  fi
}

# Fichiers de la production (`/storage/files`, volume de once) vers l'environnement, une fois son
# conteneur démarré. Un échec n'arrête pas le déploiement : la base copiée sert sans eux.
copy_production_files() { # copy_production_files <nom>
  local from to
  if ! from=$(container_of "$(host_of production)" 2>/dev/null) || ! to=$(container_of "$(host_of "$1")" 2>/dev/null); then
    echo "ardha-env : fichiers de la production non copiés (conteneur introuvable)." >&2
    return 0
  fi
  docker exec "$from" test -d /storage/files || { echo "Aucun fichier en production."; return 0; }
  if docker exec "$from" tar -C /storage -c files | docker exec -i "$to" tar -C /storage -x; then
    echo "Fichiers copiés de la production."
  else
    echo "ardha-env : copie des fichiers de la production incomplète." >&2
  fi
}

# Commandes

cmd_setup() {
  [[ -f $ARDHA_HOME/compose.yaml ]] || die "$ARDHA_HOME/compose.yaml absent : le déploiement du dépôt le copie"
  docker network inspect "$ARDHA_NETWORK" >/dev/null 2>&1 \
    || die "réseau Docker « $ARDHA_NETWORK » absent : once est-il installé ?"
  mkdir -p "$ENVS" "$ARDHA_HOME/backups"
  chmod 700 "$ARDHA_HOME" "$ENVS"
  if [[ ! -f $SECRETS ]]; then
    (umask 077 && echo "POSTGRES_PASSWORD=$(random_secret)" > "$SECRETS")
    echo "Secrets créés : $SECRETS"
  fi
  chmod 600 "$SECRETS"
  ARDHA_SERVICES=$ARDHA_SERVICES ARDHA_NETWORK=$ARDHA_NETWORK ARDHA_COMPOSE_PROJECT=$ARDHA_COMPOSE_PROJECT \
    docker compose --project-directory "$ARDHA_HOME" -f "$ARDHA_HOME/compose.yaml" --env-file "$SECRETS" \
    up --detach --wait --quiet-pull
  echo "Services prêts : $POSTGRES, $REDIS (réseau $ARDHA_NETWORK)."
}

cmd_create() {
  local name=${1:-} image='' copy=true
  check_name "$name"
  shift
  while (($#)); do
    case $1 in
      --image) image=${2:-}; shift 2 ;;
      --empty-db) copy=false; shift ;;
      *) usage ;;
    esac
  done
  [[ -n $image ]] || die "--image manquant"
  local host db prefix memory
  host=$(host_of "$name")
  db=$(database_of "$name")
  prefix=$(prefix_of "$name")
  [[ ! -f $(env_file "$name") ]] || die "$name existe déjà : « ardha-env update $name --image … »"
  services_ready
  app_exists "$host" && die "$host est déjà une application once"
  if [[ $name == pr-* ]]; then
    local count
    count=$(find "$ENVS" -name 'pr-*.env' | wc -l)
    ((count < ARDHA_MAX_PR)) || die "déjà $count environnements de PR (au plus $ARDHA_MAX_PR) : en supprimer un"
    memory=$ARDHA_MEMORY_PR
  else
    memory=$ARDHA_MEMORY_PRODUCTION
  fi

  local password
  password=$(random_secret)
  prepare_database "$name" "$db" "$password" "$copy"
  (
    umask 077
    {
      echo "DATABASE_URL=postgres://$db:$password@$POSTGRES:5432/$db"
      echo "REDIS_URL=redis://$REDIS:6379"
      echo "REDIS_PREFIX=$prefix"
      # Une PR sans copie de la production démarre sur les communes de référence (le seed ne touche
      # pas à une base qui a déjà des communes) ; la production se remplit à la demande.
      [[ $name == pr-* ]] && echo "ARDHA_SEED_ON_BOOT=true"
      echo "LOG_LEVEL=info"
    } > "$(env_file "$name")"
    printf 'HOST=%s\nIMAGE=%s\nCREATED=%s\n' "$host" "$image" "$(date -Iseconds)" > "$(meta_file "$name")"
  )

  local args=(deploy "$image" --host "$host" --memory "$memory" --auto-update=false)
  [[ $name == production ]] && args+=(--backup-path "$ARDHA_HOME/backups/production" --auto-backup)
  local envs=()
  mapfile -d '' envs < <(env_args "$name")
  args+=("${envs[@]}")
  local registry=()
  mapfile -t registry < <(registry_args)
  args+=("${registry[@]}")
  [[ $name == production ]] && mkdir -p "$ARDHA_HOME/backups/production"

  echo "Déploiement de $image sur https://$host …"
  if ! registry_password | "$ONCE" "${args[@]}"; then
    # once a déjà retiré l'application ; on retire le reste, pour ne rien laisser.
    drop_database "$db"
    rm -f "$(env_file "$name")" "$(meta_file "$name")" "$ENVS/$name.copy.log"
    die "échec du déploiement de $name : rien n'a été gardé"
  fi
  if $copied; then copy_production_files "$name"; fi
  echo "Environnement $name prêt : https://$host"
}

cmd_update() {
  local name=${1:-} image='' reset=false copy=true
  check_name "$name"
  shift
  while (($#)); do
    case $1 in
      --image) image=${2:-}; shift 2 ;;
      --reset-db) reset=true; shift ;;
      --empty-db) copy=false; shift ;;
      *) usage ;;
    esac
  done
  [[ -n $image ]] || die "--image manquant"
  $reset || $copy || die "--empty-db va avec --reset-db"
  [[ -f $(env_file "$name") ]] || die "$name n'existe pas : « ardha-env create $name --image … »"
  services_ready
  local host db
  host=$(host_of "$name")
  db=$(database_of "$name")
  if $reset; then
    [[ $name != production ]] || die "--reset-db refusé sur la production"
    local password
    password=$(sed -n "s|^DATABASE_URL=postgres://$db:\([^@]*\)@.*|\1|p" "$(env_file "$name")")
    drop_database "$db"
    drop_redis_keys "$(prefix_of "$name")"
    prepare_database "$name" "$db" "$password" "$copy"
  fi
  local envs=()
  mapfile -d '' envs < <(env_args "$name")
  echo "Mise à jour de $name vers $image …"
  local registry=()
  mapfile -t registry < <(registry_args)
  registry_password | "$ONCE" update "$host" --image "$image" "${envs[@]}" "${registry[@]}"
  sed -i "s|^IMAGE=.*|IMAGE=$image|" "$(meta_file "$name")"
  if $copied; then copy_production_files "$name"; fi
  echo "Environnement $name à jour : https://$host"
}

cmd_remove() {
  local name=${1:-} confirm=''
  check_name "$name"
  shift
  while (($#)); do
    case $1 in
      --confirm) confirm=${2:-}; shift 2 ;;
      *) usage ;;
    esac
  done
  [[ $name != production || $confirm == production ]] \
    || die "supprimer la production demande « --confirm production »"
  local host
  host=$(host_of "$name")
  if app_exists "$host"; then
    "$ONCE" remove "$host" --remove-data
  fi
  services_ready
  drop_database "$(database_of "$name")"
  drop_redis_keys "$(prefix_of "$name")"
  rm -f "$(env_file "$name")" "$(meta_file "$name")" "$ENVS/$name.copy.log"
  echo "Environnement $name supprimé."
}

cmd_list() {
  local hosts file name host status
  hosts=$(once_hosts)
  printf '%s\t%s\t%s\t%s\n' NOM HÔTE ÉTAT IMAGE
  for file in "$ENVS"/*.env; do
    [[ -e $file ]] || continue
    name=$(basename "$file" .env)
    host=$(host_of "$name")
    status=$(sed -n "s/^$host (\(.*\))$/\1/p" <<< "$hosts")
    printf '%s\t%s\t%s\t%s\n' "$name" "https://$host" "${status:-absent de once}" "$(meta "$name" IMAGE)"
  done
}

cmd_logs() {
  local name=${1:-} args=()
  check_name "$name"
  shift
  while (($#)); do
    case $1 in
      --tail) args+=(--tail "${2:-}"); shift 2 ;;
      --follow) args+=(--follow); shift ;;
      *) usage ;;
    esac
  done
  docker logs "${args[@]}" "$(container_of "$(host_of "$name")")"
}

cmd_exec() {
  local name=${1:-}
  check_name "$name"
  shift
  (($#)) || usage
  "$ONCE" exec "$(host_of "$name")" "$@"
}

cmd_psql() {
  local name=${1:-}
  check_name "$name"
  shift
  local tty=()
  [[ -t 0 ]] && tty=(-t)
  docker exec -i "${tty[@]}" "$POSTGRES" psql -U postgres -d "$(database_of "$name")" "$@"
}

# Identifiants de ghcr.io pour once (paquet privé) : le jeton (`read:packages`) arrive par l'entrée
# standard, jamais par la ligne de commande ; il rejoint secrets.env. `create` les passe à
# `once deploy`, et once les garde d'un déploiement à l'autre.
cmd_registry() {
  local username=''
  while (($#)); do
    case $1 in
      --username) username=${2:-}; shift 2 ;;
      *) usage ;;
    esac
  done
  [[ $username =~ ^[A-Za-z0-9-]+$ ]] || die "--username : identifiant GitHub attendu"
  local token
  IFS= read -r token || true
  [[ -n $token ]] || die "jeton vide : le passer sur l'entrée standard"
  [[ $token =~ ^[A-Za-z0-9_]+$ ]] || die "jeton inattendu (caractères hors [A-Za-z0-9_])"
  [[ -f $SECRETS ]] || die "$SECRETS absent : lancer « ardha-env setup »"
  (
    umask 077
    grep -v '^REGISTRY_' "$SECRETS" > "$SECRETS.tmp" || true
    printf 'REGISTRY_USERNAME=%s\nREGISTRY_PASSWORD=%s\n' "$username" "$token" >> "$SECRETS.tmp"
    mv "$SECRETS.tmp" "$SECRETS"
  )
  echo "Identifiants du registre enregistrés pour $username (pris en compte au prochain create)."
}

# Secrets de l'application, les mêmes pour tous les environnements (jeton Géorisques v2, F-04 Q12,
# porteur du produit, 02/10/2026) : la valeur arrive par l'entrée standard, jamais par la ligne de
# commande ni par la CI, et rejoint secrets.env (600) sous `APP_<NOM>`. Pris en compte au prochain
# create ou update. Seuls les noms connus de l'application sont acceptés.
APP_SECRET_NAMES=(GEORISQUES_TOKEN)

cmd_app_secret() {
  local name=${1:-}
  (($# == 1)) || usage
  [[ " ${APP_SECRET_NAMES[*]} " == *" $name "* ]] || die "secret inconnu « $name » (permis : ${APP_SECRET_NAMES[*]})"
  local value
  IFS= read -r value || true
  [[ -n $value ]] || die "valeur vide : la passer sur l'entrée standard"
  [[ $value =~ ^[A-Za-z0-9._-]+$ ]] || die "valeur inattendue (caractères hors [A-Za-z0-9._-])"
  [[ -f $SECRETS ]] || die "$SECRETS absent : lancer « ardha-env setup »"
  (
    umask 077
    grep -v "^APP_$name=" "$SECRETS" > "$SECRETS.tmp" || true
    printf 'APP_%s=%s\n' "$name" "$value" >> "$SECRETS.tmp"
    mv "$SECRETS.tmp" "$SECRETS"
  )
  echo "Secret $name enregistré (pris en compte au prochain create ou update de chaque environnement)."
}

cmd_sweep() {
  local keep=''
  while (($#)); do
    case $1 in
      # Sans valeur : aucune PR ouverte, tout part.
      --keep) keep=${2-}; shift; (($#)) && shift ;;
      *) usage ;;
    esac
  done
  [[ $keep =~ ^(pr-[0-9]{1,6}(,pr-[0-9]{1,6})*)?$ ]] || die "--keep : liste de pr-<n> séparés par des virgules"
  local file name removed=0
  for file in "$ENVS"/pr-*.env; do
    [[ -e $file ]] || continue
    name=$(basename "$file" .env)
    if [[ ,$keep, != *",$name,"* ]]; then
      cmd_remove "$name"
      removed=$((removed + 1))
    fi
  done
  echo "Balayage : $removed environnement(s) supprimé(s)."
}

# Commande forcée de la clé SSH de la CI (`command="…/ardha-env ci",restrict` dans authorized_keys) :
# la CI ne peut que créer, mettre à jour, supprimer ou balayer des environnements de PR, mettre à
# jour la production, lister et lire des journaux. Ni setup, ni psql, ni exec, ni suppression de la
# production ; images de ghcr.io/bimtheon-studio/ardha à étiquette immuable seulement. Le script
# lui-même ne se met à jour que par `pnpm server sync`, lancé par un humain.
cmd_ci() {
  local words=() image_re='^ghcr\.io/bimtheon-studio/ardha:sha-[0-9a-f]{7}$'
  read -ra words <<< "${SSH_ORIGINAL_COMMAND:-}"
  # `pnpm server` appelle `ardha/ardha-env <commande>` : même client pour un humain et pour la CI.
  [[ ${words[0]:-} == ardha/ardha-env ]] && words=("${words[@]:1}")
  set -- "${words[@]}"
  local command=${1:-} name=${2:-}
  refuse() { die "commande refusée à la CI : ${SSH_ORIGINAL_COMMAND:-(vide)}"; }
  case $command in
    list) (($# == 1)) || refuse ;;
    create | remove) [[ $name =~ ^pr-[0-9]{1,6}$ ]] || refuse ;;
    update) [[ $name =~ ^(production|pr-[0-9]{1,6})$ ]] || refuse ;;
    logs) [[ $name =~ ^(production|pr-[0-9]{1,6})$ && ($# == 2 || ($# == 4 && $3 == --tail && $4 =~ ^[0-9]{1,5}$)) ]] || refuse ;;
    sweep) [[ ${2:-} == --keep && $# -le 3 ]] || refuse ;;
    *) refuse ;;
  esac
  case $command in
    create | update)
      [[ ${3:-} == --image && ${4:-} =~ $image_re ]] || refuse
      (($# == 4)) || [[ $# == 5 && $5 == --reset-db && $name != production ]] || refuse
      ;;
    remove) (($# == 2)) || refuse ;;
  esac
  "cmd_${command//-/_}" "${@:2}"
}

command=${1:-}
(($#)) && shift
case $command in
  setup) cmd_setup "$@" ;;
  create) cmd_create "$@" ;;
  update) cmd_update "$@" ;;
  remove) cmd_remove "$@" ;;
  list) cmd_list "$@" ;;
  logs) cmd_logs "$@" ;;
  exec) cmd_exec "$@" ;;
  psql) cmd_psql "$@" ;;
  sweep) cmd_sweep "$@" ;;
  registry) cmd_registry "$@" ;;
  app-secret) cmd_app_secret "$@" ;;
  ci) cmd_ci ;;
  *) usage ;;
esac
