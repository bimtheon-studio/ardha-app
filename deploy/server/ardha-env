#!/usr/bin/env bash
# Environnements d'Ardha sur le serveur once (lot LD, D-13) : la production et un environnement par PR.
# Chaque environnement = une application once (`ardha…`), une base `ardha_<nom>` et son rôle, un
# préfixe Redis `ardha-<nom>`. Copié sur le serveur par la commande de déploiement du dépôt ; ne
# touche qu'à ce qui porte le nom d'Ardha (le serveur est partagé).
#
#   ardha-env setup                                  services partagés (Postgres, Redis), secrets
#   ardha-env create <nom> --image <image>           crée l'environnement et le déploie
#   ardha-env update <nom> --image <image> [--reset-db]
#   ardha-env remove <nom> [--confirm production]    supprime tout : application, base, clés Redis
#   ardha-env list                                   environnements, hôte, image, état
#   ardha-env logs <nom> [--tail <n>] [--follow]     journaux du conteneur
#   ardha-env exec <nom> <commande…>                 commande dans le conteneur (once exec)
#   ardha-env psql <nom> [arguments de psql…]        psql sur la base de l'environnement
#
# <nom> : `production` ou `pr-<numéro>`.
set -euo pipefail

ARDHA_HOME=${ARDHA_HOME:-$HOME/ardha}
ARDHA_DOMAIN=${ARDHA_DOMAIN:-once.florent.cc}
ARDHA_SERVICES=${ARDHA_SERVICES:-ardha}
ARDHA_COMPOSE_PROJECT=${ARDHA_COMPOSE_PROJECT:-ardha-services}
ARDHA_NETWORK=${ARDHA_NETWORK:-once}
ARDHA_MAX_PR=${ARDHA_MAX_PR:-4}
ARDHA_MEMORY_PRODUCTION=${ARDHA_MEMORY_PRODUCTION:-1024}
ARDHA_MEMORY_PR=${ARDHA_MEMORY_PR:-512}
ONCE=${ONCE:-once}

POSTGRES="$ARDHA_SERVICES-postgres"
REDIS="$ARDHA_SERVICES-redis"
SECRETS="$ARDHA_HOME/secrets.env"
ENVS="$ARDHA_HOME/envs"

die() {
  echo "ardha-env : $*" >&2
  exit 1
}

usage() {
  sed -n '/^#   ardha-env/s/^#   //p' "$0" >&2
  exit 2
}

random_secret() {
  head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' | head -c 48
}

# Noms dérivés d'un environnement.
check_name() {
  [[ ${1:-} =~ ^(production|pr-[0-9]{1,6})$ ]] || die "nom invalide « ${1:-} » : production ou pr-<numéro>"
}
host_of() { if [[ $1 == production ]]; then echo "ardha.$ARDHA_DOMAIN"; else echo "ardha-$1.$ARDHA_DOMAIN"; fi; }
database_of() { echo "ardha_${1//-/_}"; }
prefix_of() { echo "ardha-$1"; }
env_file() { echo "$ENVS/$1.env"; }
meta_file() { echo "$ENVS/$1.meta"; }

meta() { # meta <nom> <clé>
  sed -n "s/^$2=//p" "$(meta_file "$1")" 2>/dev/null || true
}

sql() { # sql <base> : exécute l'entrée standard en superutilisateur
  docker exec -i "$POSTGRES" psql -v ON_ERROR_STOP=1 -qAt -U postgres -d "$1"
}

services_ready() {
  [[ $(docker inspect -f '{{.State.Health.Status}}' "$POSTGRES" 2>/dev/null) == healthy ]] \
    || die "$POSTGRES n'est pas prêt : lancer « ardha-env setup »"
  [[ $(docker inspect -f '{{.State.Health.Status}}' "$REDIS" 2>/dev/null) == healthy ]] \
    || die "$REDIS n'est pas prêt : lancer « ardha-env setup »"
}

once_hosts() {
  # `once list` colore et lie les hôtes (séquences OSC 8) : on n'en garde que le texte.
  "$ONCE" list | sed -E 's/\x1b\]8;;[^\x1b]*\x1b\\//g; s/\x1b\[[0-9;]*m//g'
}

app_exists() { once_hosts | grep -q "^$1 "; }

# Conteneur once d'un hôte : once range ses réglages (hôte compris) dans l'étiquette `once`.
container_of() {
  local host=$1 name label
  while IFS=$'\t' read -r name label; do
    if [[ $label == *"\"host\":\"$host\""* ]]; then
      echo "$name"
      return
    fi
  done < <(docker ps --filter "name=^once-app-ardha" --format '{{.Names}}	{{.Label "once"}}')
  die "aucun conteneur en service pour $host"
}

# Arguments `--env` de once, depuis le fichier de l'environnement (update les remplace tous).
env_args() {
  local line
  while IFS= read -r line; do
    [[ -n $line && $line != \#* ]] && printf '%s\0' --env "$line"
  done < "$(env_file "$1")"
}

create_database() {
  local db=$1 password=$2
  sql postgres <<SQL
CREATE ROLE $db LOGIN PASSWORD '$password';
CREATE DATABASE $db OWNER $db;
SQL
  # Les extensions appartiennent au serveur (superutilisateur) ; les migrations les trouvent déjà là.
  sql "$db" <<SQL
CREATE EXTENSION IF NOT EXISTS postgis;
CREATE EXTENSION IF NOT EXISTS vector;
GRANT ALL ON SCHEMA public TO $db;
SQL
}

drop_database() {
  local db=$1
  sql postgres <<SQL
DROP DATABASE IF EXISTS $db WITH (FORCE);
DROP ROLE IF EXISTS $db;
SQL
}

drop_redis_keys() {
  docker exec "$REDIS" redis-cli --scan --pattern "$1:*" \
    | xargs -r -n 500 docker exec -i "$REDIS" redis-cli del >/dev/null
}

# Commandes

cmd_setup() {
  [[ -f $ARDHA_HOME/compose.yaml ]] || die "$ARDHA_HOME/compose.yaml absent : le déploiement du dépôt le copie"
  docker network inspect "$ARDHA_NETWORK" >/dev/null 2>&1 \
    || die "réseau Docker « $ARDHA_NETWORK » absent : once est-il installé ?"
  mkdir -p "$ENVS" "$ARDHA_HOME/backups"
  chmod 700 "$ARDHA_HOME" "$ENVS"
  if [[ ! -f $SECRETS ]]; then
    (umask 077 && echo "POSTGRES_PASSWORD=$(random_secret)" > "$SECRETS")
    echo "Secrets créés : $SECRETS"
  fi
  chmod 600 "$SECRETS"
  ARDHA_SERVICES=$ARDHA_SERVICES ARDHA_NETWORK=$ARDHA_NETWORK ARDHA_COMPOSE_PROJECT=$ARDHA_COMPOSE_PROJECT \
    docker compose --project-directory "$ARDHA_HOME" -f "$ARDHA_HOME/compose.yaml" --env-file "$SECRETS" \
    up --detach --wait --quiet-pull
  echo "Services prêts : $POSTGRES, $REDIS (réseau $ARDHA_NETWORK)."
}

cmd_create() {
  local name=${1:-} image=''
  check_name "$name"
  shift
  while (($#)); do
    case $1 in
      --image) image=${2:-}; shift 2 ;;
      *) usage ;;
    esac
  done
  [[ -n $image ]] || die "--image manquant"
  local host db prefix memory
  host=$(host_of "$name")
  db=$(database_of "$name")
  prefix=$(prefix_of "$name")
  [[ ! -f $(env_file "$name") ]] || die "$name existe déjà : « ardha-env update $name --image … »"
  services_ready
  app_exists "$host" && die "$host est déjà une application once"
  if [[ $name == pr-* ]]; then
    local count
    count=$(find "$ENVS" -name 'pr-*.env' | wc -l)
    ((count < ARDHA_MAX_PR)) || die "déjà $count environnements de PR (au plus $ARDHA_MAX_PR) : en supprimer un"
    memory=$ARDHA_MEMORY_PR
  else
    memory=$ARDHA_MEMORY_PRODUCTION
  fi

  local password
  password=$(random_secret)
  create_database "$db" "$password"
  (
    umask 077
    {
      echo "DATABASE_URL=postgres://$db:$password@$POSTGRES:5432/$db"
      echo "REDIS_URL=redis://$REDIS:6379"
      echo "REDIS_PREFIX=$prefix"
      # Une PR démarre sur les communes de référence ; la production se remplit à la demande.
      [[ $name == pr-* ]] && echo "ARDHA_SEED_ON_BOOT=true"
      echo "LOG_LEVEL=info"
    } > "$(env_file "$name")"
    printf 'HOST=%s\nIMAGE=%s\nCREATED=%s\n' "$host" "$image" "$(date -Iseconds)" > "$(meta_file "$name")"
  )

  local args=(deploy "$image" --host "$host" --memory "$memory" --auto-update=false)
  [[ $name == production ]] && args+=(--backup-path "$ARDHA_HOME/backups/production" --auto-backup)
  local envs=()
  mapfile -d '' envs < <(env_args "$name")
  args+=("${envs[@]}")
  if [[ -f $SECRETS ]] && grep -q '^REGISTRY_USERNAME=' "$SECRETS"; then
    args+=(--registry-username "$(sed -n 's/^REGISTRY_USERNAME=//p' "$SECRETS")" --registry-password-stdin)
  fi
  [[ $name == production ]] && mkdir -p "$ARDHA_HOME/backups/production"

  echo "Déploiement de $image sur https://$host …"
  if ! sed -n 's/^REGISTRY_PASSWORD=//p' "$SECRETS" 2>/dev/null | "$ONCE" "${args[@]}"; then
    # once a déjà retiré l'application ; on retire le reste, pour ne rien laisser.
    drop_database "$db"
    rm -f "$(env_file "$name")" "$(meta_file "$name")"
    die "échec du déploiement de $name : rien n'a été gardé"
  fi
  echo "Environnement $name prêt : https://$host"
}

cmd_update() {
  local name=${1:-} image='' reset=false
  check_name "$name"
  shift
  while (($#)); do
    case $1 in
      --image) image=${2:-}; shift 2 ;;
      --reset-db) reset=true; shift ;;
      *) usage ;;
    esac
  done
  [[ -n $image ]] || die "--image manquant"
  [[ -f $(env_file "$name") ]] || die "$name n'existe pas : « ardha-env create $name --image … »"
  services_ready
  local host db
  host=$(host_of "$name")
  db=$(database_of "$name")
  if $reset; then
    [[ $name != production ]] || die "--reset-db refusé sur la production"
    local password
    password=$(sed -n "s|^DATABASE_URL=postgres://$db:\([^@]*\)@.*|\1|p" "$(env_file "$name")")
    drop_database "$db"
    create_database "$db" "$password"
    drop_redis_keys "$(prefix_of "$name")"
    echo "Base $db recréée."
  fi
  local envs=()
  mapfile -d '' envs < <(env_args "$name")
  echo "Mise à jour de $name vers $image …"
  "$ONCE" update "$host" --image "$image" "${envs[@]}"
  sed -i "s|^IMAGE=.*|IMAGE=$image|" "$(meta_file "$name")"
  echo "Environnement $name à jour : https://$host"
}

cmd_remove() {
  local name=${1:-} confirm=''
  check_name "$name"
  shift
  while (($#)); do
    case $1 in
      --confirm) confirm=${2:-}; shift 2 ;;
      *) usage ;;
    esac
  done
  [[ $name != production || $confirm == production ]] \
    || die "supprimer la production demande « --confirm production »"
  local host
  host=$(host_of "$name")
  if app_exists "$host"; then
    "$ONCE" remove "$host" --remove-data
  fi
  services_ready
  drop_database "$(database_of "$name")"
  drop_redis_keys "$(prefix_of "$name")"
  rm -f "$(env_file "$name")" "$(meta_file "$name")"
  echo "Environnement $name supprimé."
}

cmd_list() {
  local hosts file name host status
  hosts=$(once_hosts)
  printf '%s\t%s\t%s\t%s\n' NOM HÔTE ÉTAT IMAGE
  for file in "$ENVS"/*.env; do
    [[ -e $file ]] || continue
    name=$(basename "$file" .env)
    host=$(host_of "$name")
    status=$(sed -n "s/^$host (\(.*\))$/\1/p" <<< "$hosts")
    printf '%s\t%s\t%s\t%s\n' "$name" "https://$host" "${status:-absent de once}" "$(meta "$name" IMAGE)"
  done
}

cmd_logs() {
  local name=${1:-} args=()
  check_name "$name"
  shift
  while (($#)); do
    case $1 in
      --tail) args+=(--tail "${2:-}"); shift 2 ;;
      --follow) args+=(--follow); shift ;;
      *) usage ;;
    esac
  done
  docker logs "${args[@]}" "$(container_of "$(host_of "$name")")"
}

cmd_exec() {
  local name=${1:-}
  check_name "$name"
  shift
  (($#)) || usage
  "$ONCE" exec "$(host_of "$name")" "$@"
}

cmd_psql() {
  local name=${1:-}
  check_name "$name"
  shift
  local tty=()
  [[ -t 0 ]] && tty=(-t)
  docker exec -i "${tty[@]}" "$POSTGRES" psql -U postgres -d "$(database_of "$name")" "$@"
}

command=${1:-}
(($#)) && shift
case $command in
  setup) cmd_setup "$@" ;;
  create) cmd_create "$@" ;;
  update) cmd_update "$@" ;;
  remove) cmd_remove "$@" ;;
  list) cmd_list "$@" ;;
  logs) cmd_logs "$@" ;;
  exec) cmd_exec "$@" ;;
  psql) cmd_psql "$@" ;;
  *) usage ;;
esac
